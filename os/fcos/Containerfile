ARG VERSION="v0.0.0"
ARG FEDORA_VERSION="42"

FROM quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

ARG COS_NAME="ContainerOS"
ARG COS_ID="cos"
ARG COS_VERSION="${VERSION}-${FEDORA_VERSION}"
ARG COS_HOME_URL="https://example.com"

ARG KUBERNETES_VERSION="1.32"
ARG CRIO_VERSION="1.32.0-2.fc42"
ARG RUNC_VERSION="2:1.3.3-1.fc42"
ARG CRI_TOOLS_VERSION="1.29.0-7.fc42"

### ### ### ### ### ### ### ### ### 
### packages
### ### ### ### ### ### ### ### ### 

RUN dnf install -y \
    cri-o-${CRIO_VERSION} \
    runc-${RUNC_VERSION} \
    cri-tools-${CRI_TOOLS_VERSION} \
    kubernetes${KUBERNETES_VERSION} \
    kubernetes${KUBERNETES_VERSION}-client \
    iptables \
    && dnf clean all

RUN dnf install -y cloud-init && dnf clean all

RUN systemctl enable cloud-init cloud-init-local cloud-config cloud-final

RUN dnf install -y qemu-guest-agent && dnf clean all
RUN systemctl enable qemu-guest-agent


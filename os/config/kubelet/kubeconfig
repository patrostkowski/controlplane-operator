# /etc/kubernetes/kubelet.conf
apiVersion: v1
kind: Config

clusters:
- name: mcp-cluster
  cluster:
    # Path inside the node filesystem – make sure this file exists.
    certificate-authority: /etc/kubernetes/pki/ca.crt
    # Replace with your MCP API server host:port
    # e.g. https://10.0.0.50:6443 or https://mcp-api.yourdomain:6443
    server: https://kubernetes:443

contexts:
- name: mcp-context
  context:
    cluster: mcp-cluster
    user: kubelet-bootstrap

current-context: mcp-context

users:
- name: kubelet-bootstrap
  user:
    # This must be the *plain* bootstrap token, NOT base64, in:
    #   <token-id>.<token-secret> form, e.g. abc123.def456...
    token: abc123.abcdefg123456789